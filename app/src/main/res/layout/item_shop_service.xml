<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Icon Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardIconContainer"
            android:layout_width="0dp"
            android:layout_height="115dp"
            app:cardBackgroundColor="#FFF4F4"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivServiceIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cat_powder"
                    app:tint="@color/brand_red"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvServiceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/badge_shipped"
                    android:backgroundTint="#FFE0B2"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="CERTIFIED"
                    android:textColor="#E65100"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:ignore="SmallSp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvServiceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Service Name"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardIconContainer" />

        <TextView
            android:id="@+id/tvServiceSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lines="2"
            android:maxLines="2"
            android:text="Service description and information"
            android:textColor="@color/text_gray"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvServiceName" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookService"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand_red"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Book Service"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvServiceSubtitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
